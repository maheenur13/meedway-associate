// Prisma 7 schema. Client generated to src/generated/prisma (new generator).
// Dev uses SQLite; switch datasource provider to "postgresql" for Neon later.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Job {
  id            String    @id @default(cuid())
  title         String
  category      String
  country       String
  vacancies     Int       @default(1)
  salary        String?
  workingHours  String?
  contract      String?
  experience    String?
  accommodation Boolean   @default(false)
  deadline      DateTime?
  documents     String?   // JSON-encoded string[]
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Application {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  phone      String
  whatsapp   String?
  position   String?
  country    String?
  experience String?
  address    String?
  message    String?
  cvName     String?
  cvPath     String?
  status     String   @default("new") // new | reviewed | shortlisted | rejected
  createdAt  DateTime @default(now())
}

model WorkerRequest {
  id        String   @id @default(cuid())
  company   String
  contact   String
  email     String
  phone     String
  country   String?
  category  String?
  quantity  String?
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model SiteContent {
  key     String  @id
  valueEn String?
  valueBn String?
}
