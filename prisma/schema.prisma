// Prisma 7 schema. Client generated to src/generated/prisma (new generator).
// Neon Postgres via the @prisma/adapter-pg driver adapter.
// The datasource URL lives in prisma.config.ts (CLI) / src/lib/prisma.ts (runtime),
// both reading DATABASE_URL — Prisma 7 datasource blocks take no url with adapters.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Job {
  id            String    @id @default(cuid())
  title         String
  category      String
  country       String
  vacancies     Int       @default(1)
  salary        String?
  workingHours  String?
  contract      String?
  experience    String?
  accommodation Boolean   @default(false)
  deadline      DateTime?
  documents     String?   // JSON-encoded string[]
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Application {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  phone      String
  whatsapp   String?
  position   String?
  country    String?
  experience String?
  address    String?
  message    String?
  cvName     String?
  cvPath     String?
  status     String   @default("new") // new | reviewed | shortlisted | rejected
  createdAt  DateTime @default(now())
}

model WorkerRequest {
  id        String   @id @default(cuid())
  company   String
  contact   String
  email     String
  phone     String
  country   String?
  category  String?
  quantity  String?
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model SiteContent {
  key     String  @id
  valueEn String?
  valueBn String?
}

/// Trade categories shown in the "What we provide" grid on the home page.
model TradeCategory {
  id        String   @id @default(cuid())
  nameEn    String
  nameBn    String?
  /// Key into TRADE_ICONS in src/lib/trade-categories.ts — not a free-form import.
  icon      String   @default("Users")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
